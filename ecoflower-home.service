[Unit]
Description=ecoflower-home – Verwaltung von EcoFlow-STREAM-Speichern
After=network-online.target
Wants=network-online.target

[Service]
User=ecoflower
WorkingDirectory=/opt/ecoflower-home
Environment=DATABASE_PATH=/opt/ecoflower-home/data/ecoflower.db
Environment=BIND=0.0.0.0:8080
Environment=WEB_USER=admin
Environment=WEB_PASSWORD=bitte-aendern
# Das Programm liegt in einem Ordner, der dem Dienstbenutzer gehört,
# damit es sich über die Weboberfläche selbst aktualisieren kann.
ExecStart=/opt/ecoflower-home/ecoflower-home
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
